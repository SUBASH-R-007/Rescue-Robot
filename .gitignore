# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Simulation outputs
runs/
recordings/
*.mp4

# Experiment outputs (python -m rescue.experiments): the full run's raw.csv (~10 MB),
# summary, hypotheses, run metadata and plots are committed so every reported number comes
# from a committed CSV. Everything else under results/ is ignored, including results/quick/
# (the --quick smoke run) and *.tmp files.
results/*
!results/raw.csv
!results/summary.csv
!results/HYPOTHESES.md
!results/run_meta.json
!results/plots/
results/plots/*
!results/plots/*.png
# Extension experiments (python -m rescue.ext.experiments): the full run's raw.csv, summary,
# claims, run metadata and plots are committed; results/ext/quick/ (--quick) and anything else
# under results/ext/ are ignored.
!results/ext/
results/ext/*
!results/ext/raw.csv
!results/ext/summary.csv
!results/ext/EXTENSIONS.md
!results/ext/run_meta.json
!results/ext/plots/
results/ext/plots/*
!results/ext/plots/*.png
# LAO* experiment (python -m rescue.experiments --config experiments/lao.yaml --out results/lao):
# the full run's raw.csv, summary, hypotheses, LAO.md (lao_report), run metadata and plots
# are committed.
!results/lao/
results/lao/*
!results/lao/raw.csv
!results/lao/summary.csv
!results/lao/HYPOTHESES.md
!results/lao/LAO.md
!results/lao/run_meta.json
!results/lao/plots/
results/lao/plots/*
!results/lao/plots/*.png
